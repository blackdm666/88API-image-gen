{
  "name": "88api-image-gen",
  "version": "3.1.2",
  "description": "一个插件调用 88API 全部生图模型，支持 gpt-image、香蕉、Grok 等多种生图模型。适配 Claude、ZCode、DSH 等多种客户端！",
  "icon": "plugins/88api-image-gen/assets/plugin-logo.png",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "88api",
    "image-generation",
    "nano-banana"
  ],
  "author": {
    "name": "88api.ai",
    "url": "https://88api.ai/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blackdm666/88API-image-gen.git"
  },
  "homepage": "https://github.com/blackdm666/88API-image-gen#readme",
  "bugs": {
    "url": "https://github.com/blackdm666/88API-image-gen/issues"
  },
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./locale/*": "./locale/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/",
    "locale/",
    "plugins/88api-image-gen/skills/",
    "plugins/88api-image-gen/assets/plugin-logo.png",
    "README.md",
    "VERSION.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check dsh/index.js && node --test dsh/package.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  }
}
